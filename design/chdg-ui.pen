{
  "version": "2.14",
  "children": [
    {
      "type": "frame",
      "id": "workspace-cover",
      "x": 0,
      "y": 0,
      "name": "00 / Workspace Cover",
      "width": 1440,
      "height": 900,
      "fill": "$color.bg",
      "layout": "vertical",
      "gap": "$space.6",
      "padding": [
        72,
        80
      ],
      "children": [
        {
          "type": "text",
          "id": "cover-eyebrow",
          "name": "Product",
          "fill": "$color.accentSoft",
          "content": "CLONE HERO DRUM GENERATOR",
          "fontFamily": "$font.family",
          "fontSize": "$font.size.caption",
          "fontWeight": "800",
          "letterSpacing": 1.8
        },
        {
          "type": "text",
          "id": "cover-title",
          "name": "Title",
          "fill": "$color.text",
          "content": "CHDG Design Workspace",
          "fontFamily": "$font.family",
          "fontSize": 56,
          "fontWeight": "800",
          "letterSpacing": -1.6
        },
        {
          "type": "text",
          "id": "cover-description",
          "name": "Description",
          "fill": "$color.textSoft",
          "textGrowth": "fixed-width",
          "width": 820,
          "content": "Issue #89 baseline workspace. Recreate and audit the current Angular/Electron desktop UI before proposing a redesign.",
          "lineHeight": 1.5,
          "fontFamily": "$font.family",
          "fontSize": 20,
          "fontWeight": "normal"
        },
        {
          "type": "note",
          "id": "cover-scope",
          "name": "Scope Guardrail",
          "width": 760,
          "height": 220,
          "content": "DESIGN-ONLY PHASE\n• Read production code for context.\n• Write only inside design/.\n• Do not modify Angular/Electron behavior.\n• Do not introduce React, Tailwind, or invented features.\n• Keep all repository artifacts in English."
        },
        {
          "type": "text",
          "id": "cover-next-step",
          "name": "Next Step",
          "fill": "$color.muted",
          "content": "Next: run prompts/01-verify-workspace.md with Pencil open.",
          "fontFamily": "$font.family",
          "fontSize": 15,
          "fontWeight": "normal"
        }
      ]
    },
