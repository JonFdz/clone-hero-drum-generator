{
  "name": "@chdg/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "pnpm build:renderer && pnpm build:electron",
    "build:renderer": "ng build --configuration production",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "ng build --configuration development && tsc -p tsconfig.electron.json --noEmit",
    "lint": "echo \"lint not configured yet\"",
    "test": "echo \"tests not configured yet\"",
    "dev": "pnpm build && electron dist/electron/main.js"
  },
  "dependencies": {
    "@angular/animations": "^19.2.0",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/router": "^19.2.0",
    "electron": "^35.0.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^19.2.0",
    "@angular/cli": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "typescript": "5.8.3"
  }
}
