{
  "name": "@chdg/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "pnpm build:renderer && pnpm build:electron",
    "build:renderer": "CI=1 ng build --configuration production",
    "build:browser": "CI=1 ng build --configuration browser-harness",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "CI=1 ng build --configuration development && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint .",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test": "vitest run",
    "dev": "pnpm build && electron dist/electron/main.js",
    "dev:browser": "CI=1 ng serve --configuration browser-harness --host 127.0.0.1 --port 4200"
  },
  "dependencies": {
    "@angular/animations": "^19.2.0",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@chdg/project": "workspace:*",
    "electron": "^35.0.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^19.2.0",
    "@angular/cli": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "@eslint/js": "^9",
    "angular-eslint": "^19",
    "eslint": "^9",
    "happy-dom": "^20.10.6",
    "typescript": "5.8.3",
    "typescript-eslint": "^8",
    "vitest": "^4.1.5"
  }
}
